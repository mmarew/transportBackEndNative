{
  "openapi": "3.0.3",
  "info": {
    "title": "Transport Management System API",
    "version": "1.0.0",
    "description": "Complete API for transport management system including user management, driver operations, admin functions, and finance operations",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://api.transportapp.com",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["fullName", "phoneNumber", "roleId"],
        "properties": {
          "userUniqueId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the user"
          },
          "fullName": {
            "type": "string",
            "description": "Full name of the user"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Phone number of the user"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the user"
          },
          "roleId": {
            "type": "integer",
            "description": "Role ID (1=Shipper, 2=Driver, 3=Admin)"
          },
          "statusId": {
            "type": "integer",
            "description": "Status ID of the user"
          },
          "userCreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "User creation timestamp"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "error": {
            "type": "string",
            "description": "Detailed error description"
          },
          "details": {
            "type": "object",
            "description": "Additional error details"
          }
        }
      },
      "Deposit": {
        "type": "object",
        "properties": {
          "userDepositUniqueId": {
            "type": "string",
            "format": "uuid"
          },
          "userUniqueId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "depositStatus": {
            "type": "string",
            "enum": ["requested", "approved", "rejected"]
          },
          "depositSourceUniqueId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateVehicleRequest": {
        "type": "object",
        "required": ["vehicleTypeUniqueId", "licensePlate", "color"],
        "properties": {
          "vehicleTypeUniqueId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of an existing VehicleTypes row."
          },
          "licensePlate": {
            "type": "string",
            "description": "Plate number. Whitespace is stripped server-side; an existing plate reuses its Vehicle row."
          },
          "color": {
            "type": "string",
            "description": "Vehicle colour."
          },
          "companyUniqueId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional. When present the new vehicle is linked to this company fleet in the same transaction. Required for a company admin using the no-driver target; rejected for drivers."
          },
          "isDriverOwnerOfVehicle": {
            "type": "boolean",
            "description": "Accepted for backwards compatibility but currently ignored. Driver-target registrations always create a VehicleOwnership row; no-driver registrations create none."
          }
        }
      },
      "CreateVehicleResponse": {
        "type": "object",
        "required": ["message", "data"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Vehicle created successfully"
          },
          "data": {
            "type": "object",
            "required": ["vehicleUniqueId"],
            "properties": {
              "vehicleUniqueId": {
                "type": "string",
                "format": "uuid",
                "description": "UUID of the Vehicle row."
              },
              "vehicleOnly": {
                "type": "boolean",
                "description": "Present and true only for the no-driver-is-assigned-yet target."
              },
              "message": {
                "type": "string",
                "description": "Present when the target driver already has an active vehicle; no new vehicle is created in that case."
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/user/vehicles/driverUserUniqueId/{driverUserUniqueId}": {
      "post": {
        "tags": ["Vehicles"],
        "summary": "Register a vehicle (self / driver / unassigned company vehicle)",
        "description": "Register a vehicle for self, for a driver UUID, or as a vehicle with no driver assigned.",
        "operationId": "createVehicle",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "driverUserUniqueId",
            "in": "path",
            "required": true,
            "description": "self, a driver UUID, or no-driver-is-assigned-yet.",
            "schema": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "description": "A driver's userUniqueId. Admin/super admin/company admin only."
                },
                {
                  "type": "string",
                  "enum": ["self", "no-driver-is-assigned-yet"]
                }
              ]
            },
            "examples": {
              "Driver registers own vehicle": { "value": "self" },
              "Admin registers for a driver": { "value": "9ad44404-7974-42b6-b2cb-b42d6808c65d" },
              "Company vehicle with no driver": { "value": "no-driver-is-assigned-yet" }
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateVehicleRequest" },
              "examples": {
                "Self": {
                  "summary": "Self",
                  "value": {
                    "vehicleTypeUniqueId": "fddf2911-dfa5-4363-a04f-c82e59536fa4",
                    "licensePlate": "AA-1234",
                    "color": "White base red sponda",
                    "isDriverOwnerOfVehicle": false
                  }
                },
                "Driver UUID": {
                  "summary": "Driver UUID",
                  "value": {
                    "vehicleTypeUniqueId": "fddf2911-dfa5-4363-a04f-c82e59536fa4",
                    "licensePlate": "AA-5678",
                    "color": "White",
                    "companyUniqueId": "a1f0c1e2-9c2d-4a10-a2ad-7b2c1ef0a8d4",
                    "isDriverOwnerOfVehicle": false
                  }
                },
                "No driver assigned": {
                  "summary": "No driver assigned",
                  "value": {
                    "vehicleTypeUniqueId": "fddf2911-dfa5-4363-a04f-c82e59536fa4",
                    "licensePlate": "AA-9012",
                    "color": "White",
                    "companyUniqueId": "a1f0c1e2-9c2d-4a10-a2ad-7b2c1ef0a8d4"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vehicle registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateVehicleResponse" },
                "examples": {
                  "With driver": {
                    "value": {
                      "message": "Vehicle created successfully",
                      "data": { "vehicleUniqueId": "2f3b0c9a-1f8e-4d55-9a83-9c8f0d0e1a11" }
                    }
                  },
                  "Vehicle only": {
                    "value": {
                      "message": "Vehicle created successfully",
                      "data": {
                        "vehicleUniqueId": "7a9e0b21-1e56-45c9-8a25-4eb1a90b6b3d",
                        "vehicleOnly": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "status": "error",
                  "error": "companyUniqueId is required to register a company vehicle without a driver"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired Bearer token.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "status": "error", "error": "Invalid token. Please log in again!" }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "status": "error", "error": "Access Denied: you are not an active member of the company that owns this resource" }
              }
            }
          },
          "404": {
            "description": "Vehicle type or company not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": {
            "description": "Server error during registration.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Health Check",
        "description": "Check if the server is running",
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Server is running"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/user/createUser": {
      "post": {
        "summary": "Create User",
        "description": "Create a new user (shipper or driver)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              },
              "example": {
                "fullName": "John Doe",
                "phoneNumber": "+1234567890",
                "roleId": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/user/verifyUserByOTP": {
      "post": {
        "summary": "Verify User OTP",
        "description": "Verify user's phone number using OTP",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["roleId", "OTP", "phoneNumber"],
                "properties": {
                  "roleId": {
                    "type": "integer",
                    "description": "Role ID (1=Shipper, 2=Driver, 3=Admin)"
                  },
                  "OTP": {
                    "type": "string",
                    "description": "OTP code received via SMS"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Phone number to verify"
                  }
                }
              },
              "example": {
                "roleId": 1,
                "OTP": "123456",
                "phoneNumber": "+1234567890"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "JWT token for authentication"
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "string",
                      "example": "OTP verified successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/createUserByAdminOrSuperAdmin": {
      "post": {
        "summary": "Create Admin User",
        "description": "Create a new admin user (requires Super Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              },
              "example": {
                "fullName": "Admin User",
                "phoneNumber": "+1234567890",
                "email": "admin@company.example",
                "roleId": 3,
                "statusId": 1,
                "userRoleStatusDescription": "System administrator"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin user created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/finance/userDeposit": {
      "get": {
        "summary": "Get User Deposits",
        "description": "Retrieve user deposits with optional filtering",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userUniqueId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "User UUID or 'self' for current user"
          },
          {
            "name": "depositStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["approved", "requested", "rejected"]
            },
            "description": "Filter by deposit status"
          }
        ],
        "responses": {
          "200": {
            "description": "Deposits retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Deposit"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create User Deposit",
        "description": "Create a new deposit request",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "depositSourceUniqueId"],
                "properties": {
                  "amount": {
                    "type": "number",
                    "format": "decimal",
                    "description": "Deposit amount"
                  },
                  "depositSourceUniqueId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Deposit source UUID"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deposit created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Deposit"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
