# =================================================================
# TRANSPORT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# MySQL Database Settings
DB_HOST=''
DB_USER=''
DB_PASSWORD=''
DB_DATABASE=''
DB_PORT=''
DB_CONNECT_TIMEOUT=''

# Optional: For local MySQL socket connection (macOS with MAMP)
# DB_SOCKET_PATH=/Applications/MAMP/tmp/mysql/mysql.sock

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================
# JWT Secret Key - Generate a strong random string
SECRET_KEY=''

# API Key for external integrations
API_KEY=''

# =================================================================
# FILE UPLOADS & STORAGE
# =================================================================
# FTP Configuration for document uploads
FTP_HOST=''
FTP_USER=''
FTP_PASSWORD=''
FTP_UPLOADS_PATH=''

# =================================================================
# SUPER ADMIN CONFIGURATION
# =================================================================
# Initial Super Admin User (created on first run)
SUPER_ADMIN_FULL_NAME=''
SUPER_ADMIN_PHONE=''
SUPER_ADMIN_EMAIL=''
SUPER_ADMIN_TEMP_PASSWORD=''

# Internal "system" actor (role 5) used by background jobs (queue sweeps,
# automated timeouts). Required to identify the seeded system user.
SYSTEM_FULL_NAME='system'
SYSTEM_PHONE=''
SYSTEM_EMAIL=''

# =================================================================
# EXTERNAL SERVICES
# =================================================================

# SMS Service Configuration
SMS_TOKEN=''
AFRO_BASE_URL=''
SMS_SENDER=''
OTP_TEMPLATE=''

# FCM (Firebase Cloud Messaging) for Push Notifications
FCM_SERVICE_ACCOUNT_JSON=''

# SantimPay Payment Gateway
SANTIMPAY_MERCHANT_ID=''
SANTIMPAY_PRIVATE_KEY=''
SANTIMPAY_BASE_URL='https://testapi.santimpay.com/v1/gateway'
SANTIMPAY_SUCCESS_REDIRECT_URL='https://your-frontend.com/payment/success'
SANTIMPAY_FAILURE_REDIRECT_URL='https://your-frontend.com/payment/failure'
SANTIMPAY_CANCEL_REDIRECT_URL='https://your-frontend.com/payment/cancel'
SANTIMPAY_WEBHOOK_URL='https://your-api.com/api/finance/userDeposit/santimPay/webhook'

# Redis Cache (Optional - for session storage and caching)
UPSTASH_REDIS_URL=''

# =================================================================
# APPLICATION SETTINGS
# =================================================================

# Environment: development | staging | production
NODE_ENV=''

# Allow localhost/dev origins in CORS, CSRF and Socket.IO allow-lists.
# MUST be false (or unset) on the production hub so local tooling can never
# call it. Dev sandbox (dev.dynamicsroute.tech) sets this to 'true'.
ENABLE_LOCAL_DEV_ORIGINS='false'

# Additional comma-separated origins to allow (optional, any environment):
# EXTRA_ALLOWED_ORIGINS='https://preview.dynamicsroute.tech,http://localhost:5174'

# Use the fixed test OTP (below) and disable real SMS gateway calls.
# Dev sandbox sets 'true'; production MUST NOT set this.
USE_TEST_OTP='false'
# TEST_OTP='101010'

# Auto desk
Auto_desk=''

# =================================================================
# DEVELOPMENT NOTES
# =================================================================
# Production Database Example:
# DB_HOST=91.204.209.6
# DB_USER=transport_prod
# DB_PASSWORD=secure_password_here
# DB_DATABASE=transport_prod

# Local Development Example (MAMP):
# DB_HOST=localhost
# DB_PORT=8888
# DB_USER=transport
# DB_PASSWORD=transport@C5202
# DB_DATABASE=transport

