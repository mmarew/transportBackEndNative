{
  "name": "transportwithnative",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "main": "App.js",
  "scripts": {
    "test": "node E2ETests/index.js",
    "test:log": "rm -f test.log && npx jest --no-coverage --verbose > test.log 2>&1; tail -20 test.log | grep -E '^(PASS|FAIL|Test Suites|Tests:|Suites:|Snapshot:)'; echo 'Full output in test.log'",
    "test:e2e": "node E2ETests/index.js",
    "test:e2e:log": "rm -f test-e2e.log && node E2ETests/index.js > test-e2e.log 2>&1; tail -10 test-e2e.log; echo 'Full output in test-e2e.log'",
    "compare:logs": "node scripts/compare-logs.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "eslint . --watch",
    "spellcheck": "cspell --no-progress '**/*.js'",
    "spellcheck:fix": "cspell --no-progress --words-only '**/*.js' | sort -u",
    "start": "node App.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 delete ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "logs:pm2": "pm2 logs",
    "status:pm2": "pm2 status",
    "dev": "pm2 delete ecosystem.config.js && nodemon App.js",
    "start:cluster": "pm2 start ecosystem.config.js --watch",
    "db:create": "curl -X POST http://localhost:3000/api/admin/createTable -H 'Content-Type: application/json'",
    "db:seed": "echo 'Usage: npm run db:seed -- --token=YOUR_SUPER_ADMIN_TOKEN' && echo 'Example: npm run db:seed -- --token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...'",
    "nginx:start": "sudo nginx",
    "nginx:stop": "sudo nginx -s stop",
    "nginx:stop-force": "sudo pkill -9 nginx",
    "nginx:restart": "sudo nginx -s stop && sudo nginx",
    "nginx:reload": "sudo nginx -s reload",
    "nginx:test": "sudo nginx -t",
    "nginx:status": "ps aux | grep nginx",
    "nginx:logs": "tail -f /usr/local/var/log/nginx/error.log",
    "nginx:logs-access": "tail -f /usr/local/var/log/nginx/access.log",
    "nginx:config": "code /usr/local/etc/nginx/nginx.conf",
    "nginx:fix-port80": "sudo lsof -i :80 | awk 'NR>1 {print $2}' | xargs sudo kill -9",
    "knip": "knip"
  },
  "author": "Marew Masresha Abate",
  "target": "node",
  "license": "ISC",
  "description": "A track management system like Uber Freight",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "kill-port": "^2.0.1",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3",
    "pm2": "^7.0.3",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "node-forge": "1.4.0",
    "picomatch": "4.0.4",
    "@tootallnate/once": "^2.0.0",
    "dicer": "0.3.1",
    "form-data": "2.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "cspell": "^9.8.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^25.0.0",
    "knip": "^6.32.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
